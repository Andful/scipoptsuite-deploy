# Structure
# {
#   enable: Enable build setting. Otherwise, this build is skipped.
#   os: OS to build for
#   architecture: The architecture to build for
#   debug: Build in debug if true, otherwise release 
#   exact: Build with exact fractional solve enabled if true, otherwise it is disabled
#   runs_on: The GitHub runner to perform the build
#   image: The Docker image used to perform the build. If null, the build is directly performed on the OS
#   shell: The shell to use
# }
[
    {
        "enable": true,
        "os": "windows",
        "architecture": "x86_64",
        "debug": false,
        "exact": false,
        "runs_on": "windows-latest",
        "image": null,
        "shell": "msys2 {0}"
    },
    {
        "enable": true,
        "os": "linux",
        "architecture": "x86_64",
        "debug": false,
        "exact": false,
        "runs_on": "ubuntu-latest",
        "image": "quay.io/pypa/manylinux_2_28_x86_64",
        "shell": "bash"
    },
    {
        "enable": true,
        "os": "linux",
        "architecture": "arm",
        "debug": false,
        "exact": false,
        "runs_on": "ubuntu-24.04-arm",
        "image": "quay.io/pypa/manylinux_2_28_aarch64",
        "shell": "bash"
    },
    {
        "enable": true,
        "os": "macos",
        "architecture": "x86_64",
        "debug": false,
        "exact": false,
        "runs_on": "macos-15-intel",
        "image": null,
        "shell": "bash"
    },
    {
        "enable": true,
        "os": "macos",
        "architecture": "arm",
        "debug": false,
        "exact": false,
        "runs_on": "macos-14",
        "image": null,
        "shell": "bash"
    }
]